#!/bin/bash
#
# Usage on linux:
# $ sudo apt install zsh git curl -y
# $ /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/imotov/omyzc/main/bootstrap)"
#

set -e
OS=$(uname)
PROJECT_HOME="$HOME/Projects/imotov"
OMYZC_HOME="$PROJECT_HOME/omyzc"

for cmd in git curl zsh; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "Error: $cmd is required but not installed." >&2; exit 1; }
done

if [[ $OS == "Darwin" ]]; then
    xcode-select -p >/dev/null 2>&1 || { echo "Error: Xcode Command Line Tools are required (run 'xcode-select --install')." >&2; exit 1; }
fi

ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 | grep -q "successfully authenticated" \
    || { echo "Error: unable to authenticate to GitHub over SSH. Add an SSH key to your GitHub account first (https://docs.github.com/en/authentication/connecting-to-github-with-ssh)." >&2; exit 1; }

read -p "Enter your git email address: " GIT_EMAIL
git config --global user.name "Igor Motov"
git config --global user.email "$GIT_EMAIL"
git config --global core.editor nano
if [[ $OS == "Darwin" ]]; then
    git config --global credential.helper osxkeychain
else
    grep -q "^$USER:" /etc/passwd && chsh $USER -s /usr/bin/zsh
fi

mkdir -p "$PROJECT_HOME"
cd "$PROJECT_HOME"
git clone git@github.com:imotov/omyzc.git

sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

sed -i.bak -E \
    -e 's|^[[:space:]]*#?[[:space:]]*ZSH_THEME=.*|ZSH_THEME="westwood"|' \
    -e 's|^[[:space:]]*#?[[:space:]]*ZSH_CUSTOM=.*|ZSH_CUSTOM="$HOME/Projects/imotov/omyzc"|' \
    -e 's|^[[:space:]]*#?[[:space:]]*plugins=\(.*\)|plugins=(git docker docker-compose mamba conda-env)|' \
    "$HOME/.zshrc"

